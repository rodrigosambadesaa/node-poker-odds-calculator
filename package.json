{
  "name": "poker-odds-calculator",
  "version": "0.4.0",
  "type": "module",
  "description": "A pre-flop and post-flop odds calculator for Texas Holdem",
  "bin": {
    "poker-odds-calculator": "./dist/bin/poker-odds-calculator.js"
  },
  "main": "./dist/index.js",
  "typings": "./dts/index.d.ts",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('dts',{recursive:true,force:true})\" && tsc",
    "lint": "eslint --ext .ts --ignore-pattern dist/ --ignore-pattern dts/ ./src",
    "test": "node -e \"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc --project tsconfig.test.json && mocha --timeout 120000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigosambadesaa/node-poker-odds-calculator.git"
  },
  "keywords": [
    "poker",
    "odds",
    "equity"
  ],
  "author": "Mickael Burguet <www.rundef.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">= 8"
  },
  "dependencies": {
    "chalk": "^5.4.0",
    "commander": "^13.0.0",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/lodash": "^4.14.52",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "chai": "^5.2.0",
    "eslint": "^9.30.1",
    "mocha": "^11.7.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.3"
  },
  "files": [
    "dist/",
    "dts/",
    "README.md",
    "LICENSE.md"
  ]
}
