{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "outDir": "./dist/",
    "sourceMap": true,
    "inlineSourceMap": false,
    "inlineSources": false,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": false,
    "declaration": true,
    "moduleResolution": "node16",
    "declarationDir": "./dts/",
    "lib": [
      "ES2022"
    ]
  },
  "exclude": [
    "node_modules",
    "test"
  ]
}
